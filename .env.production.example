BANKING_IMAGE=your-registry/banking-platform@sha256:replace-with-verified-image-digest
DATABASE_URL=jdbc:postgresql://db.example:5432/banking?sslmode=verify-full
DATABASE_USER=banking_app
DATABASE_PASSWORD=replace-via-secret-manager
JWT_ISSUER_URI=https://identity.example/realms/banking
JWT_JWK_SET_URI=https://identity.example/realms/banking/protocol/openid-connect/certs
JWT_AUDIENCE=banking-api
